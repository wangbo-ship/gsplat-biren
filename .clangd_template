# To set up the clangd config for repository-local C++/SUPA extension sources.
# Run:
#       echo "# Autogenerated, see .clangd_template\!" > .clangd && sed -e "/^#/d" .clangd_template >> .clangd
CompileFlags:
  Add:
    - -std=c++17
    - -I/usr/local/birensupa/sdk/latest/include
    - -I/usr/local/birensupa/sdk/latest/brcc/include
  Remove: 
    - --diag_suppress=*
    - -forward-unknown-to-host-compiler
    - -Xcompiler
    - --use_fast_math
    - --options-file
    - --compiler-options
    - --expt-relaxed-constexpr
